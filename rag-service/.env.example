# PostgreSQL connection (same DB AyurSutra already uses, must have pgvector extension enabled)
DATABASE_URL=postgresql://user:password@host:5432/ayursutra_db

# Google Gemini API key (Required for embeddings via gemini-embedding-001 & automatic LLM fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key — optional/primary generation, get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model used for Groq generation
GROQ_MODEL=llama-3.1-8b-instant

# Minimum similarity score (0-1, cosine) below which the bot admits it doesn't know
CONFIDENCE_THRESHOLD=0.35

# How many chunks to retrieve per query
TOP_K=4

